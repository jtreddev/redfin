{
  "name": "fin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Family budget app: Cloudflare Worker + D1 + React PWA",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply fin --local",
    "db:migrate:remote": "wrangler d1 migrations apply fin --remote",
    "backup": "node scripts/backup.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-plaid-link": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@cloudflare/workers-types": "^5.20260914.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  },
  "allowScripts": {
    "workerd@1.20261012.1": true,
    "esbuild@0.28.2": true
  }
}
